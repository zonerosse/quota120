{
  "name": "quota120",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "STATO", "class_name": "Stato" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stato"] }],
  "triggers": { "crons": ["5 * * * *"] },
  // mittente degli avvisi e indirizzo che riceve le risposte (non sono segreti); le chiavi stanno nei segreti di Cloudflare
  "vars": { "MITTENTE": "avvisi@kennelmanager.app", "RISPOSTE": "assistenza@kennelmanager.app" },
  "keep_vars": true
}
